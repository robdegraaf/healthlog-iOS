    "insights.recovery.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strain, training load and autonomic charge appear here once a wearable such as WHOOP, Polar or Oura reports them. The recovery score on the overview doesn't need them: it comes from resting heart rate, HRV and sleep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belastung, Trainingslast und autonome Ladung erscheinen hier, sobald ein Wearable wie WHOOP, Polar oder Oura sie liefert. Der Erholungswert im Überblick braucht sie nicht: Er kommt aus Ruhepuls, HRV und Schlaf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Belasting, trainingsbelasting en autonome lading verschijnen hier zodra een wearable zoals WHOOP, Polar of Oura ze doorgeeft. De herstelscore in het overzicht heeft ze niet nodig: die is gebaseerd op rusthartslag, HRV en slaap."
          }
        }
      },
      "comment": "W-B189 #23 — Recovery empty-state body. K1: explains why the overview's recovery score can exist while this page is empty (server v1.39.2 splits them the same way)."
    },
    "insights.recovery.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wearable readings yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Wearable-Werte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen metingen van een wearable"
          }
        }
      },
      "comment": "W-B189 #23 — Recovery empty-state title. K1: names what is missing (device signals), because the overview can show a recovery score at the same time."
    },
