    "med.lifecycle.footer.active": {
      "comment": "Build 6.2 — footer for an active med",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausieren setzt die Einnahmen vorübergehend aus (zählt nicht als verpasst). Beenden schließt die Behandlung zum heutigen Tag ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausing temporarily suspends doses (they don't count as missed). Ending closes the course as of today."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeren zet de doses tijdelijk stop (ze tellen niet als gemist). Beëindigen sluit de behandeling af per vandaag."
          }
        }
      }
    },
