          "stringUnit": {
            "state": "translated",
            "value": "The assistant stops answering until you enter a key again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent antwoordt pas weer als je opnieuw een sleutel invoert."
          }
        }
      }
    },
    "The assistant will forget everything it has learned about you. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent vergisst alles, was er über dich gelernt hat. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant will forget everything it has learned about you. This cannot be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent vergeet alles wat hij over je heeft geleerd. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "The bot was blocked in Telegram.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot wurde im Telegram blockiert."
          }
