            "state": "translated",
            "value": "Zodra een Bluetooth-apparaat is gekoppeld, komen metingen automatisch in je overzicht."
          }
        }
      }
    },
    "Once there are enough measurement pairs (at least 5 days per metric), correlations will appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald genug Messpaare vorliegen (mindestens 5 Tage je Metrik), erscheinen hier Zusammenhänge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once there are enough measurement pairs (at least 5 days per metric), correlations will appear here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra er genoeg meetparen zijn (minstens 5 dagen per metriek), verschijnen hier verbanden."
          }
        }
      }
    },
    "Once you log medications and acknowledge reminders, your %lld-week compliance history appears here.": {
      "comment": "Medications compliance heatmap — empty state, %lld = selected window length in weeks (#13)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
