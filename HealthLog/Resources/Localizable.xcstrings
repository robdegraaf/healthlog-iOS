    "integration.sync.upstreamUnavailable": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. 502; %@ is the provider name. Names the provider as the place the fault sits, because the user cannot repair it and must not go looking.",
