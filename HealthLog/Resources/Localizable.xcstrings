    "insights.sameTimeBaseline.legend": {
      "comment": "CU-30 (C5) - Same-Time-Baseline card: today's cumulative total vs the operator's own typical standing at the same hour of day (server SAME_TIME_BASELINE)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchgezogen: heute. Gestrichelt: dein üblicher Verlauf, also der Mittelwert je Stunde, kein einzelner echter Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid: today. Dashed: your usual course, meaning the per-hour median, not one real day."
          }
