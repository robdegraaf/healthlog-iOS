    },
    "Your server doesn't have an assistant provider set up yet. Configure one below, or ask your server's operator to add one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat noch keinen Assistent-Anbieter eingerichtet. Konfiguriere unten einen oder bitte den Betreiber deines Servers, einen hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server doesn't have an assistant provider set up yet. Configure one below, or ask your server's operator to add one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je server is nog geen assistentaanbieder ingesteld. Stel er hieronder een in of vraag de beheerder van je server er een toe te voegen."
          }
        }
      }
    },
    "Your server provides the assistant. No provider key is stored in this app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server stellt den Assistenten bereit. In dieser App ist kein Anbieter-Schlüssel gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server provides the assistant. No provider key is stored in this app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server levert de assistent. Er is geen sleutel van een aanbieder in deze app bewaard."
          }
        }
      }
    },
    "Your server forwards them to its configured AI provider to generate personal insights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server leitet sie an seinen konfigurierten KI-Anbieter weiter, um persönliche Einblicke zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server forwards them to its configured AI provider to generate personal insights."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server stuurt ze door naar de ingestelde AI-aanbieder om persoonlijke inzichten te maken."
          }
        }
      }
    },
    "Your server receives this data and forwards it to its AI provider under that provider's privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server erhält diese Daten und leitet sie an seinen KI-Anbieter weiter, gemäß dessen Datenschutzrichtlinie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server receives this data and forwards it to its AI provider under that provider's privacy policy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server ontvangt deze gegevens en stuurt ze door naar zijn AI-aanbieder, volgens het privacybeleid van die aanbieder."
          }
        }
      }
    },
    "Your server uses an OpenAI-compatible endpoint. It is configured on the server, not in this app.": {
