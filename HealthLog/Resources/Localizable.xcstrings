    "sessions.signOutAll.else.footer": {
      "comment": "Sessions screen — footer under the sign-out-everywhere button on servers from v1.38.11, where this device is spared.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen ab und widerruft die Anmeldung aller anderen Apps. Dieses Gerät bleibt angemeldet. Nutze das, wenn du ein Gerät verloren hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and revokes every other app sign-in. This device stays signed in. Use this if you have lost a device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt elke browsersessie uit en trekt elke andere login in de app in. Dit apparaat blijft ingelogd. Gebruik dit als je een apparaat kwijt bent."
          }
        }
      }
    },
    "sessions.signOutAll.footer": {
      "comment": "Sessions screen — footer under the sign-out-everywhere button. States the honest consequence: on iOS the server also revokes this device's refresh token.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen ab und widerruft die Anmeldung aller Apps, auch auf diesem Gerät. Nutze das, wenn du ein Gerät verloren hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and revokes every app sign-in, including on this device. Use this if you have lost a device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt elke browsersessie uit en trekt elke login in de app in, ook op dit apparaat. Gebruik dit als je een apparaat kwijt bent."
          }
        }
      }
    },
