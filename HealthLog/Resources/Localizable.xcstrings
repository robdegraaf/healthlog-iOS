    "med.edit.live_activity.footer": {
      "comment": "v0.8.5 WFIX-LA — one-line explanation under the Live Activity toggle in the medication edit sheet.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt für dieses Medikament eine Live-Aktivität mit Countdown und „Genommen“-Knopf auf dem Sperrbildschirm und in der Dynamic Island. Am besten nur für zeitkritische Medikamente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a Live Activity for this medication with a countdown and a “Taken” button on the Lock Screen and in the Dynamic Island. Best kept on only for time-critical medications."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont voor dit medicijn een live activiteit met een aftelklok en een knop 'Ingenomen' op het toegangsscherm en in het Dynamic Island. Zet dit het liefst alleen aan voor medicijnen waarbij het tijdstip cruciaal is."
          }
        }
      }
    },
