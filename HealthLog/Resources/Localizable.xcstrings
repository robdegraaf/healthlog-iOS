    "insights.bp.derived.meanArterialPressure": {
      "comment": "BP detail — mean arterial pressure derived caption; %d is whole mmHg",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der mittlere arterielle Druck (der Durchschnitt, den deine Organe sehen) liegt bei etwa %d mmHg, normalerweise um 70 bis 100."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mean arterial pressure (the average your organs see) is about %d mmHg, normally around 70 to 100."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemiddelde arteriële druk (het gemiddelde dat je organen krijgen) is ongeveer %d mmHg, normaal tussen ongeveer 70 en 100."
          }
        }
      }
    },
