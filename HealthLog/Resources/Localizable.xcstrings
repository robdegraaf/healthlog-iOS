    "error.detail.unauthorized": {
      "comment": "Error detail — 401",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erneut anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please sign in again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log opnieuw in."
          }
        }
      }
    },
    "error.detail.rateLimited": {
      "comment": "Error detail — 429",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. Versuch es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. Probeer het later opnieuw."
          }
        }
      }
    },
    "error.detail.replayInFlight": {
      "comment": "Error detail — the server is still processing the same idempotent request",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird noch verarbeitet. Wird automatisch erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still being processed. It will be retried automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt nog verwerkt. Het wordt automatisch opnieuw geprobeerd."
          }
        }
      }
    },
    "error.detail.offline": {
      "comment": "Error detail — the device is offline",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen netwerk."
          }
        }
      }
    },
