    "sessions.signOutAll.else.confirmBody": {
      "comment": "Sessions screen — confirm dialog body on servers from v1.38.11, where the route spares the calling device. The pre-1.38.11 wording stays in sessions.signOutAll.confirmBody.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen werden beendet und alle anderen App-Anmeldungen widerrufen. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session ends and every other app sign-in is revoked. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke browsersessie wordt beëindigd en elke andere login in de app wordt ingetrokken. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.else.doneBody": {
      "comment": "Sessions screen — success alert body on servers from v1.38.11, where the calling device keeps its sign-in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen wurden beendet und alle anderen App-Anmeldungen widerrufen. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
