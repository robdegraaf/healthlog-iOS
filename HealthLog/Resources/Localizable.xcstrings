    "disclaimer.ack.intro.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog is a private tracking tool, not a clinical assessment or diagnosis. If you're ever worried, talk to your doctor, not this app. Please read this once; you can always find it again under Settings > About."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog ist ein privates Tracking-Werkzeug, keine klinische Bewertung oder Diagnose. Wenn du dir Sorgen machst, sprich mit deiner Ärztin oder deinem Arzt, nicht mit dieser App. Bitte lies dies einmal; du findest es jederzeit wieder unter Einstellungen > Über."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog is een persoonlijk hulpmiddel om dingen bij te houden, geen klinische beoordeling of diagnose. Maak je je ooit zorgen, praat dan met je arts, niet met deze app. Lees dit één keer door; je vindt het altijd terug onder Instellingen > Info."
          }
        }
      }
    },
