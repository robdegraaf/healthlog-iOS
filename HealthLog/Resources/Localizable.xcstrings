        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorgetrokken lijn: vandaag. Stippellijn: je gebruikelijke verloop, dat wil zeggen de mediaan per uur, niet één echte dag."
          }
        }
      }
    },
    "insights.sameTimeBaseline.percent %@": {
