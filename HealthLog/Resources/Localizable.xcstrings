    "shareLink.error.forbiddenLeaf": {
      "comment": "CU-12 user-facing copy for 422 share-link.selection.forbidden_leaf",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgewählter Inhalt darf nicht über einen Freigabe-Link geteilt werden (zum Beispiel Versicherungsdaten). Nimm ihn aus der Auswahl und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the selected contents can't be shared through a share link (insurance details, for example). Remove it from the selection and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van de gekozen onderdelen kan niet via een deellink worden gedeeld (bijvoorbeeld verzekeringsgegevens). Haal het uit de selectie en probeer het opnieuw."
          }
        }
      }
    },
    "shareLink.error.selectionRejected": {
      "comment": "CU-12 user-facing copy for any other 422 share-link.selection.* refusal",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die gewählten Inhalte abgelehnt. Öffne die Auswahl noch einmal (die Liste wird dabei neu geladen) und wähle erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the contents you picked. Open the selection again (that reloads the list) and choose once more."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft de gekozen onderdelen geweigerd. Open de selectie opnieuw (daarmee wordt de lijst opnieuw geladen) en kies nog een keer."
          }
        }
      }
    },
    "shareLink.remint.body": {
      "comment": "CU-12 create-sheet honest explanation of what a re-mint is and isn't",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der alte Link bleibt widerrufen und lässt sich nicht wiederherstellen. Du erstellst hier einen neuen Link mit neuem Token und neuer Passphrase. Beides muss deine Ärztin oder dein Arzt neu bekommen. Die Inhalte musst du erneut auswählen, denn die alte Auswahl ist nicht mehr lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old link stays revoked and can't be restored. You're creating a new link here, with a new token and a new passphrase. Your clinician needs both again. You also have to pick the contents again, because the old selection can no longer be read."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oude link blijft ingetrokken en kan niet worden hersteld. Je maakt hier een nieuwe link aan, met een nieuw token en een nieuwe wachtwoordzin. Je arts heeft beide opnieuw nodig. Je moet ook de onderdelen opnieuw kiezen, omdat de oude selectie niet meer kan worden gelezen."
          }
        }
      }
    },
