    "settings.hkdiag.history_subtitle": {
      "comment": "1.3 #127 — Sync Diagnostics: card subtitle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit dein älterer Verlauf schon übertragen ist. Neue Werte laufen getrennt davon und gehen zuerst."
          }
        },
        "en": {
          "stringUnit": {
