    "sources.sheet.footer": {
      "comment": "1.4.1 — sources sheet footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeine Informationen aus veröffentlichten Leitlinien und Studien, keine ärztliche Beurteilung deiner Person. Referenzbereiche sind Richtwerte; dein Labor, deine Ärztin oder dein Arzt und deine Vorgeschichte gehen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General information from published guidelines and studies, not a medical assessment of you. Reference ranges are orientation values; your lab, doctor and personal history come first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Algemene informatie uit gepubliceerde richtlijnen en onderzoeken, geen medische beoordeling van jou. Referentiebereiken zijn richtwaarden; je lab, je arts en je eigen voorgeschiedenis gaan voor."
          }
        }
      }
    },
