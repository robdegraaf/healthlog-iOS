            "state": "translated",
            "value": "Transparenz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparency"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparantie"
          }
        }
      }
    },
