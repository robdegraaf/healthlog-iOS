        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The doctor will lose access immediately. This can't be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De arts verliest direct de toegang. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "The endpoint answers 404 and no assistant can connect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Endpunkt antwortet mit 404. Kein Assistent kann sich verbinden."
