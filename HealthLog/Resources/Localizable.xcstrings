    "insights.ecg.crossLink.title": {
      "comment": "P8 parity — pulse-page ECG cross-link (mirrors web insights.ecg.crossLink.*); shows only that recordings exist + the DEVICE's last result, never the trace",
      "extractionState": "manual",
      "localizations": {
        "de": {
