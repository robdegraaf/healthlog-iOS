      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald ein Bluetooth-Gerät gekoppelt ist, landen Messungen automatisch auf deinem Dashboard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a Bluetooth device is paired, measurements land on your dashboard automatically."
          }
        },
        "nl": {
