    "settings.about.updates.no_version_check": {
      "comment": "08-07 — SettingsAboutScreen Updates row. States the limit of what this app knows; it performs no version check of any kind.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog prüft nicht selbst auf neue Versionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog does not check for new versions itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog controleert zelf niet op nieuwe versies."
          }
        }
      }
    },
    "settings.advanced.biometricLock.description": {
      "comment": "Privacy & Security — help text under the Biometric lock toggle; explains what it gates and that nothing is sent to the server.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlangt Face ID oder Touch ID bei jedem Öffnen oder Zurückkehren in die App. Deine Daten bleiben auf diesem Gerät; nichts zur Sperre wird an den Server gesendet. Jederzeit abschaltbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Face ID or Touch ID every time you open or return to the app. Your data stays on this device; nothing about the lock is sent to the server. You can turn this off anytime."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt om Face ID of Touch ID telkens als je de app opent of ernaar terugkeert. Je gegevens blijven op dit apparaat; niets over de vergrendeling wordt naar de server gestuurd. Je kunt dit altijd uitschakelen."
          }
        }
      }
    },
    "settings.aiprovider.title": {
      "comment": "Screen title",
      "extractionState": "manual",
