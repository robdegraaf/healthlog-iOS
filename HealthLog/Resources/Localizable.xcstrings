    "mentalHealth.items.gad7.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nervosität, Ängstlichkeit oder Anspannung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling nervous, anxious, or on edge"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U nerveus, angstig of gespannen voelen"
          }
        }
      }
    },
    "mentalHealth.items.gad7.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht in der Lage sein, Sorgen zu stoppen oder zu kontrollieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not being able to stop or control worrying"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet kunnen stoppen met u zorgen maken of dit niet kunnen beteugelen"
          }
        }
      }
    },
    "mentalHealth.items.gad7.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übermäßige Sorgen bezüglich verschiedener Angelegenheiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worrying too much about different things"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U te veel zorgen maken om verschillende dingen"
          }
        }
      }
    },
    "mentalHealth.items.gad7.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten zu entspannen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble relaxing"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moeite hebben u te ontspannen"
          }
        }
      }
    },
    "mentalHealth.items.gad7.5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastlosigkeit, sodass Stillsitzen schwerfällt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being so restless that it is hard to sit still"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo rusteloos zijn dat het moeilijk is om stil te zitten"
          }
        }
      }
    },
    "mentalHealth.items.gad7.6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle Verärgerung oder Gereiztheit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becoming easily annoyed or irritable"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snel geërgerd of geïrriteerd zijn"
          }
        }
      }
    },
    "mentalHealth.items.gad7.7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefühl der Angst, als würde etwas Schlimmes passieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling afraid as if something awful might happen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bang zijn dat er iets vreselijks zou kunnen gebeuren"
          }
        }
      }
    },
    "mentalHealth.items.phq9.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Interesse oder Freude an Ihren Tätigkeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little interest or pleasure in doing things"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weinig interesse of plezier in activiteiten"
          }
        }
      }
    },
    "mentalHealth.items.phq9.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedergeschlagenheit, Schwermut oder Hoffnungslosigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling down, depressed, or hopeless"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zich neerslachtig, depressief of hopeloos voelen"
          }
        }
      }
    },
    "mentalHealth.items.phq9.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten, ein- oder durchzuschlafen, oder vermehrter Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble falling or staying asleep, or sleeping too much"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moeilijk inslapen, moeilijk doorslapen of te veel slapen"
          }
        }
      }
    },
    "mentalHealth.items.phq9.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Müdigkeit oder Gefühl, keine Energie zu haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling tired or having little energy"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zich moe voelen of gebrek aan energie hebben"
          }
        }
      }
    },
    "mentalHealth.items.phq9.5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminderter Appetit oder übermäßiges Bedürfnis zu essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor appetite or overeating"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weinig eetlust of overmatig eten"
          }
        }
      }
    },
    "mentalHealth.items.phq9.6": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Meinung von sich selbst; Gefühl, ein Versager zu sein oder die Familie enttäuscht zu haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling bad about yourself, or that you are a failure or have let yourself or your family down"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een slecht gevoel hebben over uzelf, of het gevoel hebben dat u een mislukkeling bent of het gevoel dat u zichzelf of uw familie teleurgesteld hebt"
          }
        }
      }
    },
    "mentalHealth.items.phq9.7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten, sich auf etwas zu konzentrieren, z. B. beim Zeitunglesen oder Fernsehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouble concentrating on things, such as reading the newspaper or watching television"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Problemen om u te concentreren, bijvoorbeeld om de krant te lezen of om tv te kijken"
          }
        }
      }
    },
    "mentalHealth.items.phq9.8": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waren Ihre Bewegungen oder Ihre Sprache so verlangsamt, dass es auch anderen auffallen würde? Oder waren Sie im Gegenteil „zappelig“ oder ruhelos und hatten einen stärkeren Bewegungsdrang als sonst?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving or speaking so slowly that other people could have noticed. Or the opposite: being so fidgety or restless that you have been moving around a lot more than usual"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo traag bewegen of zo langzaam spreken dat andere mensen dit opgemerkt kunnen hebben? Of het tegenovergestelde, zo zenuwachtig of rusteloos zijn dat u veel meer bewoog dan gebruikelijk"
          }
        }
      }
    },
    "mentalHealth.items.phq9.9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedanken, dass Sie lieber tot wären oder sich Leid zufügen möchten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoughts that you would be better off dead, or of hurting yourself in some way"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gedachte dat u beter dood zou kunnen zijn of de gedachte uzelf op een bepaalde manier pijn te doen"
          }
        }
      }
    },
    "mentalHealth.items.sci.1": {
