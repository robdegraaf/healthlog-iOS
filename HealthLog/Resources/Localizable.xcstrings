    "settings.applehealth_import.privacy_delete": {
      "comment": "APH-IMP-stub — privacy step 4: ZIP deleted after parsing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ZIP-Datei wird nach dem Parsen vom Server gelöscht. Nur die übernommenen Werte bleiben in deinem Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ZIP file is deleted from the server after parsing. Only the imported values remain in your account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het ZIP-bestand wordt na het verwerken van de server verwijderd. Alleen de geïmporteerde waarden blijven in je account."
          }
        }
      }
    },
    "settings.applehealth_import.privacy_footer": {
      "comment": "APH-IMP-stub — footer below privacy card spelling out the contract verbatim.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Import lädt deine Apple-Health-Export-ZIP einmalig auf den Server hoch. Dort wird die XML-Datei parsing-only verarbeitet, die ZIP nicht gespeichert. Stats kommen zurück, ZIP gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During import your Apple Health export ZIP is uploaded to the server once. The XML file is processed parse-only and the ZIP is not retained. Stats come back, ZIP gets deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij de import wordt je Apple Health-export-ZIP eenmalig naar de server geüpload. Het XML-bestand wordt alleen uitgelezen en de ZIP wordt niet bewaard. De statistieken komen terug, de ZIP wordt verwijderd."
          }
        }
      }
    },
    "settings.applehealth_import.privacy_parse": {
      "comment": "APH-IMP-stub — privacy step 2: server parses XML parse-only.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server liest die XML-Datei nur aus. Sie wird nicht abgelegt, nicht weitergeleitet und nicht für Training benutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server only parses the XML. It is not stored, not forwarded and not used for training."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server leest het XML-bestand alleen uit. Het wordt niet opgeslagen, niet doorgestuurd en niet gebruikt voor training."
          }
        }
      }
    },
    "settings.applehealth_import.privacy_stats": {
      "comment": "APH-IMP-stub — privacy step 3: stats returned.",
      "extractionState": "manual",
      "localizations": {
