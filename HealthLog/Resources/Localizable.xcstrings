    "sources.hub.intro": {
      "comment": "1.4.1 — hub intro",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog zeigt Referenzbereiche, Scores und Erklärungen. Diese Seite nennt für jede davon die Herkunft und die Rechenweise. Jede Referenz öffnet das Originaldokument."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog shows reference ranges, scores and explanations. This page lists where every one of them comes from and how it is computed. Each reference opens the original document."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog toont referentiebereiken, scores en uitleg. Op deze pagina zie je voor elk daarvan waar het vandaan komt en hoe het wordt berekend. Elke referentie opent het originele document."
          }
        }
      }
    },
