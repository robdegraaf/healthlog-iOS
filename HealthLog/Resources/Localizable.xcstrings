    "mentalHealth.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Screening-Selbsttest, keine Diagnose. Ein hoher oder niedriger Wert bedeutet nicht, dass eine Erkrankung vorliegt oder nicht. Nur eine qualifizierte Fachperson kann eine Diagnose stellen. Bei Sorgen sprich bitte mit deiner Ärztin oder deinem Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a screening self-assessment, not a diagnosis. A high or low score does not mean you do or do not have a condition. Only a qualified health professional can diagnose. If you have concerns, please talk to your doctor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een zelftest voor screening, geen diagnose. Een hoge of lage score betekent niet dat je wel of geen aandoening hebt. Alleen een bevoegde zorgverlener kan een diagnose stellen. Maak je je zorgen, praat dan met je arts."
          }
        }
      }
    },
    "mentalHealth.error": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan. Probeer het opnieuw."
          }
        }
      }
    },
    "mentalHealth.followUpHint.gad7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert liegt in einem Bereich, in dem ein Gespräch mit einer Fachperson helfen kann. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your score is in a range where talking to a health professional may help. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je score ligt in een bereik waarbij een gesprek met een zorgverlener kan helpen. Dit is een voorzichtige suggestie, geen diagnose."
          }
        }
      }
    },
    "mentalHealth.followUpHint.phq9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert liegt in einem Bereich, in dem ein Gespräch mit einer Fachperson helfen kann. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your score is in a range where talking to a health professional may help. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je score ligt in een bereik waarbij een gesprek met een zorgverlener kan helpen. Dit is een voorzichtige suggestie, geen diagnose."
          }
        }
      }
    },
    "mentalHealth.followUpHint.sci": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Studie zu diesem Fragebogen waren Werte von 16 oder darunter mit wahrscheinlicher Insomnie verbunden. Wenn schlechter Schlaf dich weiter belastet, kann ein Gespräch mit einer Fachperson helfen. Das ist keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the study behind this questionnaire, scores of 16 or below were associated with probable insomnia. If poor sleep keeps troubling you, talking to a health professional may help. This is not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het onderzoek achter deze vragenlijst hingen scores van 16 of lager samen met waarschijnlijke slapeloosheid. Blijf je last houden van slecht slapen, dan kan een gesprek met een zorgverlener helpen. Dit is geen diagnose."
          }
        }
      }
    },
    "mentalHealth.followUpHint.who5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wohlbefindens-Wert von 50 oder darunter kann einen genaueren Blick wert sein. Wenn du magst, schaut der PHQ-9-Check-in auf dieser Seite genauer auf die Stimmung. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A well-being score of 50 or below can be worth a closer look. If you like, the PHQ-9 check-in on this page looks at mood in more depth. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een welzijnsscore van 50 of lager kan het waard zijn om nader te bekijken. Als je wilt, kijkt de PHQ-9-check-in op deze pagina uitgebreider naar je stemming. Dit is een voorzichtige suggestie, geen diagnose."
          }
        }
      }
    },
