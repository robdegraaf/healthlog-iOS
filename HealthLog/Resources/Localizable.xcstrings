    "nutrients.list.empty.moduleOff.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange das Nährstoff-Modul aus ist, fragt HealthLog Apple Health gar nicht erst nach Vitaminen, Mineralstoffen, Wasser und Koffein, auch dann nicht, wenn dort Werte liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the nutrients module is off, HealthLog never asks Apple Health for vitamins, minerals, water and caffeine, not even when values are sitting there."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang de module Voedingsstoffen uitstaat, vraagt HealthLog Apple Health nooit om vitaminen, mineralen, water en cafeïne, zelfs niet als daar waarden klaarstaan."
          }
        }
      }
    },
