          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Constructie voor slaapregelmaat; geen universele grens voor goed of slecht. Lees het als een persoonlijke trend."
          }
        }
      }
    },
    "sources.caveat.cdc-2024-sleep": {
      "comment": "1.4.1 caveat",
