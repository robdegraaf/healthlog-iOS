    },
    "settings.hkdiag.kinds_subtitle": {
      "comment": "BF-5 — Per-kind list card explainer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüft heißt, die App hat nachgesehen. Neuer Wert heißt, etwas Neues ging an den Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked means the app looked. New value means something new went to the server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerd betekent dat de app heeft gekeken. Nieuwe waarde betekent dat er iets nieuws naar de server is gegaan."
          }
        }
      }
    },
    "settings.hkdiag.kinds_title": {
      "comment": "BF-5 — Per-kind list card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Messgröße"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kind"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per soort"
          }
        }
      }
    },
    "settings.hkdiag.limits_bgrefresh": {
      "comment": "#66 P0.1 — Background App Refresh switch bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „Hintergrundaktualisierung“ ausgeschaltet, entfallen die kurzen Auffrisch-Läufe komplett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Background App Refresh” is off, the quick refresh runs are skipped entirely."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als 'Ververs op achtergrond' uit staat, worden de korte verversingen helemaal overgeslagen."
          }
        }
      }
    },
    "settings.hkdiag.limits_discretion": {
      "comment": "#66 P0.1 — system discretion bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet selbst, wann es weckt, meist beim Laden oder nachts. Neue Daten können daher erst mit Verzögerung am Server ankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides when to wake the app, usually while charging or overnight. New data can therefore reach the server only after a delay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bepaalt zelf wanneer de app wordt gewekt, meestal tijdens het opladen of 's nachts. Nieuwe gegevens kunnen daardoor pas met vertraging op de server aankomen."
          }
        }
      }
    },
    "settings.hkdiag.limits_footer": {
      "comment": "#66 P0.1 — system-limits card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen alle Wecks „Noch nichts“, obwohl die App lief? Dann hält iOS die Hintergrund-Zeit zurück. Das ist kein App-Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All wakes still say “Nothing yet” even though the app has run? Then iOS is withholding background time. That is not an app bug."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat bij alle wekmomenten nog 'Nog niets' terwijl de app wel heeft gedraaid? Dan houdt iOS achtergrondtijd achter. Dat is geen fout in de app."
          }
        }
      }
    },
    "settings.hkdiag.limits_forcequit": {
      "comment": "#66 P0.1 — force-quit limit bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischst du die App aus dem App-Umschalter weg (Force-Quit), stoppt iOS alle Hintergrund-Wecks bis zum nächsten manuellen Öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping the app away in the App Switcher (force-quit) stops all background wakes until you open it again manually."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de app wegveegt in de appkiezer (geforceerd stoppen), stopt iOS alle wekmomenten op de achtergrond tot je de app weer zelf opent."
          }
        }
      }
    },
    "settings.hkdiag.limits_openIosSettings": {
      "comment": "UI-Standard R4 (U2) — Absprung, der den Prosa-Wegweiser auf „Hintergrundaktualisierung“ ersetzt.",
      "extractionState": "manual",
