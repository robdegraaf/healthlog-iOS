    "health.permissions.control_body": {
      "comment": "v0.7.0 W-APPSTORE — user-control card body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jeden Datentyp einzeln ändern oder den Zugriff vollständig widerrufen. Das geht in Apple Health über dein Profilbild > Datenschutz > Apps > HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change each data type individually or revoke access entirely. In Apple Health, go to your profile picture > Privacy > Apps > HealthLog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt elk gegevenstype afzonderlijk wijzigen of de toegang volledig intrekken. Ga in Apple Health naar je profielfoto > Privacy > Apps > HealthLog."
          }
        }
      }
    },
    "health.permissions.control_footer": {
      "comment": "v0.7.0 W-APPSTORE — user-control card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog überträgt Gesundheitsdaten nur an deinen eigenen Server und niemals an Dritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog only transmits health data to your own server, never to third parties."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog stuurt gezondheidsgegevens alleen naar je eigen server, nooit naar derden."
          }
        }
      }
    },
    "health.permissions.control_title": {
      "comment": "v0.7.0 W-APPSTORE — user-control card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behältst die Kontrolle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You Stay in Control"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij houdt de controle"
          }
        }
      }
    },
    "health.permissions.intro_body": {
      "comment": "v0.7.0 W-APPSTORE — intro card body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Liste zeigt, was HealthLog bei Apple Health anfragt. Ob du das Lesen erlaubt hast, gibt Apple der App nicht preis. Sichtbar ist nur, ob Daten ankommen. Für das Schreiben steht der erteilte Zustand unten an jedem Typ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list shows what HealthLog requests from Apple Health. Apple does not tell the app whether you allowed reading. All that is visible is whether data arrives. For writing, the granted state is shown next to each type below."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze lijst laat zien wat HealthLog bij Apple Health opvraagt. Apple vertelt de app niet of je lezen hebt toegestaan. Alleen zichtbaar is of er gegevens binnenkomen. Voor schrijven staat de toegekende status hieronder bij elk type."
          }
        }
      }
    },
    "health.permissions.intro_title": {
      "comment": "v0.7.0 W-APPSTORE — intro card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
