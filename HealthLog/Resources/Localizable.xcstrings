            "state": "translated",
            "value": "Klaar. Er was daar niets nieuws."
          }
        }
      }
    },
    "integration.sync.failed": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. Fallback copy for a non-HLError failure of a manual sync.",
