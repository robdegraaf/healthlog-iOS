    "settings.security.stepUp.body": {
      "comment": "Explains the step-up wall without pretending the app can clear it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dein Konto ist die Zwei-Faktor-Anmeldung aktiv. Der Server verlangt dafür eine frische Bestätigung, die die App derzeit nicht liefern kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-factor sign-in is active on your account. The server requires a fresh confirmation that the app cannot currently provide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweestapsverificatie is actief voor je account. De server vraagt om een nieuwe bevestiging die de app op dit moment niet kan geven."
          }
        }
      }
    },
