    "settings.hkdiag.report.footer": {
      "comment": "W5 — Footer of the report card: what the report contains and what it leaves out.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Textfassung dieser Seite zum Einfügen in eine Fehlermeldung: Build, Serverversion, Stand pro Typ, zurückgehaltene Einträge nach Grund und die letzten Auslöser. Ohne Messwerte und ohne persönliche Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A text version of this page to paste into a bug report: build, server version, state per type, entries held back by reason and the last triggers. No readings and no personal data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tekstversie van deze pagina om in een foutmelding te plakken: build, serverversie, status per type, tegengehouden registraties per reden en de laatste triggers. Geen metingen en geen persoonsgegevens."
          }
        }
      }
    },
