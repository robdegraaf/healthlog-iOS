      }
    },
    "integration.sync.nothingLanded": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. outcome == failed on a 200: the run ran, but nothing was written.",
      "extractionState": "manual",
      "localizations": {
