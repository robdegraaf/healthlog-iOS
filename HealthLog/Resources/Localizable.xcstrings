    "settings.applehealth.history.unknown": {
      "comment": "1.3 #127 — Apple Health settings: history state not known yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach dem nächsten Sync angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown after the next sync."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt getoond na de volgende synchronisatie."
          }
        }
      }
    },
    "settings.applehealth.history.note": {
      "comment": "1.3 public #25 — Apple Health settings: what the full catch-up does and what it needs.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Alles jetzt synchronisieren“ sendet deinen ganzen Verlauf am Stück. Lass die App dabei offen und das iPhone am Ladegerät. Je nach Verlauf kann das eine Weile dauern und etwas Akku kosten. Du kannst jederzeit anhalten, es geht nichts verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Sync everything now\" sends your whole history in one go. Keep the app open and the iPhone on the charger. Depending on how much history you have, this can take a while and use some battery. You can stop at any time, nothing is lost."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Nu alles synchroniseren’ verstuurt je volledige geschiedenis in één keer. Houd de app open en de iPhone aan de lader. Afhankelijk van hoeveel geschiedenis je hebt, kan dit even duren en wat batterij kosten. Je kunt op elk moment stoppen, er gaat niets verloren."
          }
        }
      }
    },
    "settings.applehealth.history.sync_all": {
      "comment": "1.3 public #25 — Apple Health settings: button that sends the whole history in one go.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles jetzt synchronisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync everything now"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu alles synchroniseren"
          }
        }
      }
    },
    "settings.applehealth.history.stop": {
      "comment": "1.3 public #25 — Apple Health settings: stops the running full catch-up.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen"
          }
        }
      }
    },
    "settings.applehealth.history.running": {
      "comment": "1.3 public #25 — Apple Health settings: full catch-up in progress.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft. Bitte lass die App offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running. Please keep the app open."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig. Houd de app open."
          }
        }
      }
    },
    "settings.applehealth.history.stalled": {
      "comment": "1.3 public #25 — Apple Health settings: full catch-up stopped after several rounds without progress.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert, weil gerade nichts durchkommt. Versuch es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused because nothing is getting through right now. Try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd omdat er nu niets doorkomt. Probeer het later opnieuw."
          }
        }
      }
    },
    "settings.applehealth.history.cancelled": {
      "comment": "1.3 public #25 — Apple Health settings: full catch-up stopped by the person or by iOS.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten. Beim nächsten Mal geht es dort weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped. Next time it carries on from there."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt. De volgende keer gaat het verder waar het was gebleven."
          }
        }
      }
    },
    "settings.hkdiag.history_title": {
      "comment": "1.3 #127 — Sync Diagnostics: card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf pro Typ"
