    "med.inventory.expiry.rule.firstUseClock": {
      "comment": "CU-23 / B2 (server v1.33.0) - expiry rule caption for PEN and AMPOULE: the printed date and the 30-day-after-opening clock both apply.",
      "localizations": {
        "de": {
          "stringUnit": {
