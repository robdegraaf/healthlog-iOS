    "onboarding.sso.error.disabled": {
      "comment": "SSO error oidc_disabled",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Single Sign-on ist auf diesem Server nicht aktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single sign-on isn't enabled on this server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Single sign-on is niet ingeschakeld op deze server."
          }
        }
      }
    },
    "onboarding.sso.error.invalidRequest": {
      "comment": "SSO error oidc_invalid_request",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldeanfrage war unvollständig. Bitte starte Single Sign-on erneut aus der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in request was incomplete. Please start single sign-on again from the app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het inlogverzoek was onvolledig. Start single sign-on opnieuw vanuit de app."
          }
        }
      }
    },
    "onboarding.sso.error.failed": {
      "comment": "SSO error oidc_failed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung über deinen Identitätsanbieter hat nicht geklappt. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with your identity provider didn't work. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen via je identiteitsprovider is niet gelukt. Probeer het opnieuw."
          }
        }
      }
    },
    "onboarding.sso.error.linkRequired": {
      "comment": "SSO error oidc_link_required (server v1.39.3)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto muss einmal im Browser mit Single Sign-on verbunden werden. Melde dich im Web an und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account needs to be connected to single sign-on once in the browser. Sign in on the web, then try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account moet eenmalig in de browser aan single sign-on worden gekoppeld. Log in op het web en probeer het daarna opnieuw."
          }
        }
      }
    },
    "onboarding.auth.error.rateLimitedRetry %@": {
      "comment": "Sign-in 429 with Retry-After; %@ is a localized duration such as '15 minutes'",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Bitte versuch es in %@ erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Please try again in %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Probeer het over %@ opnieuw."
          }
        }
      }
    },
    "stepUp.record.required": {
      "comment": "Shown on a record action (share link, token, backup) when the server asks for a fresh proof",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte bestätige, dass du es bist, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please confirm it's you to continue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat jij het bent om door te gaan."
          }
        }
      }
    },
    "stepUp.record.body": {
      "comment": "Body of the step-up sheet in front of a record action",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit gibst du deine Gesundheitsdaten oder einen dauerhaften Zugang dazu weiter. Bestätige, dass du es bist, dann geht es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This hands your health record, or lasting access to it, to someone. Confirm it's you, then it continues."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee geef je je gezondheidsdossier, of blijvende toegang ertoe, aan iemand anders. Bevestig dat jij het bent, dan gaat het verder."
          }
        }
      }
    },
    "sessions.signOutAll.keepShareLinks": {
      "comment": "Toggle on the sessions screen: sign out everywhere but keep clinician share links (keepShareLinks=1)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arzt-Links behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep doctor share links"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deellinks voor artsen behouden"
          }
        }
      }
    },
    "sessions.signOutAll.everything.confirmBody": {
      "comment": "Sign out everywhere confirmation, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen und alle anderen App-Anmeldungen werden beendet. Auch verbundene KI-Assistenten, API-Tokens und Arzt-Links funktionieren danach nicht mehr. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session and every other app sign-in ends. Connected AI assistants, API tokens and doctor share links stop working too. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle browsersessies en alle andere app-aanmeldingen worden beëindigd. Ook gekoppelde AI-assistenten, API-tokens en deellinks voor artsen werken daarna niet meer. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.everything.keepLinks.confirmBody": {
      "comment": "Sign out everywhere confirmation with share links kept, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen und alle anderen App-Anmeldungen werden beendet. Auch verbundene KI-Assistenten und API-Tokens funktionieren danach nicht mehr. Deine Arzt-Links bleiben aktiv. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session and every other app sign-in ends. Connected AI assistants and API tokens stop working too. Your doctor share links stay active. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle browsersessies en alle andere app-aanmeldingen worden beëindigd. Ook gekoppelde AI-assistenten en API-tokens werken daarna niet meer. Je deellinks voor artsen blijven actief. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.everything.footer": {
      "comment": "Sign out everywhere footer, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen und alle anderen Apps ab und beendet verbundene KI-Assistenten, API-Tokens und Arzt-Links. Dieses Gerät bleibt angemeldet. Nutze das, wenn du ein Gerät verloren hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and every other app, and ends connected AI assistants, API tokens and doctor share links. This device stays signed in. Use this if you have lost a device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt alle browsersessies en alle andere apps uit en beëindigt gekoppelde AI-assistenten, API-tokens en deellinks voor artsen. Dit apparaat blijft ingelogd. Gebruik dit als je een apparaat kwijt bent."
          }
        }
      }
    },
    "sessions.signOutAll.everything.doneBody": {
      "comment": "Sign out everywhere done, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen und App-Anmeldungen wurden beendet, ebenso verbundene KI-Assistenten, API-Tokens und Arzt-Links. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other sessions and app sign-ins have ended, and so have connected AI assistants, API tokens and doctor share links. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere sessies en app-aanmeldingen zijn beëindigd, net als gekoppelde AI-assistenten, API-tokens en deellinks voor artsen. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.everything.keepLinks.doneBody": {
      "comment": "Sign out everywhere done with share links kept, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen und App-Anmeldungen wurden beendet, ebenso verbundene KI-Assistenten und API-Tokens. Deine Arzt-Links sind weiter aktiv. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other sessions and app sign-ins have ended, and so have connected AI assistants and API tokens. Your doctor share links are still active. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere sessies en app-aanmeldingen zijn beëindigd, net als gekoppelde AI-assistenten en API-tokens. Je deellinks voor artsen zijn nog actief. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.grantsKept %@": {
      "comment": "After sign out everywhere: accepted access grants the server kept (grantsKept); %@ is a list of names",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterhin Einblick in deine Daten haben, weil du ihnen Zugriff gegeben hast: %@. Den Zugriff kannst du im Web beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still able to see your data, because you gave them access: %@. You can end their access on the web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunnen je gegevens nog steeds zien, omdat je ze toegang hebt gegeven: %@. Je kunt hun toegang op het web beëindigen."
          }
        }
      }
    },
    "measurement.readOnly.aggregate": {
      "comment": "#115 R3 — measurement row that is an hourly/daily mean or a sleep night (synthetic server key), not an editable reading.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfassung mehrerer Messungen, hier nicht bearbeitbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summary of several readings. It can't be edited here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een samenvatting van meerdere metingen. Deze kan hier niet worden bewerkt."
          }
        }
      }
    },
    "mood.droppedKeys.title": {
      "comment": "#115 R3 — alert title after a mood save where the server dropped unknown or archived tag/factor keys.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Tags wurden nicht gespeichert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some tags weren't saved"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige tags zijn niet opgeslagen"
          }
        }
      }
    },
    "mood.droppedKeys.message": {
      "comment": "#115 R3 — alert message: the mood entry was kept, unknown or archived tag/factor keys were not.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Eintrag ist gespeichert. Einige der gewählten Tags oder Faktoren gibt es nicht mehr, deshalb wurden sie nicht mitgespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entry was saved. Some of the tags or factors you picked no longer exist, so they weren't stored with it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je registratie is opgeslagen. Sommige tags of factoren die je hebt gekozen bestaan niet meer, dus die zijn er niet bij opgeslagen."
          }
        }
      }
    },
    "notif.med.runwayTail.hint": {
      "comment": "R5 — second line of the last locally scheduled medication reminder of a course that continues; opening the app schedules the following ones.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne HealthLog, damit deine nächsten Erinnerungen geplant werden."
          }
        },
        "en": {
