    },
    "This build configuration is missing the chat module. Please reinstall the app.": {
      "comment": "v0.5.7 G.3 — AskCoachSheet fallback shown when SpeziChat is not linkable in this build configuration.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Build-Konfiguration enthält das Chat-Modul nicht. Bitte App neu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build configuration is missing the chat module. Please reinstall the app."
          }
        },
