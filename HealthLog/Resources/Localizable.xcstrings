    "sessions.signOutAll.confirmAction": {
      "comment": "Sessions screen — destructive confirm button for sign-out-everywhere",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überall abmelden"
          }
