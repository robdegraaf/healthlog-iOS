        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezorging"
          }
        }
      }
    },
    "med.edit.live_activity": {
      "comment": "v0.8.5 WFIX-LA — medication edit sheet toggle that opts this medication into a Live Activity (Lock-Screen + Dynamic Island dose countdown).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
