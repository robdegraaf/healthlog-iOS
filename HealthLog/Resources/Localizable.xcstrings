        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het venster voor de toegangssleutel kan niet worden getoond. Probeer het opnieuw."
          }
        }
      }
    },
    "auth.passkey.error.unexpectedResponse": {
      "comment": "Sign-in — the system returned a credential of an unexpected type",
